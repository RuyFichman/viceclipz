# Backend only. Never add these secrets to frontend code or Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
DATA_DIR=/app/data
# Public frontend URL on Vercel (stable production URL or your domain)
APP_ORIGIN=https://studio.example.com
# Host of the backend behind its HTTPS reverse proxy, without scheme
BACKEND_HOST=api.example.com
# Same backend URL, also set this single variable in Vercel
BACKEND_ORIGIN=https://api.example.com
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
BILLING_REQUIRED=true
# Production initially allows signup only for these invited emails.
BETA_EMAILS=
# Transactional email: verify the sending domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=ViceClipz <contas@example.com>
# Production always requires verification; true also enables enforcement locally.
EMAIL_VERIFICATION_REQUIRED=true
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Version enabled for your Meta app, for example vNN.N (use a supported version)
META_API_VERSION=
# Optional backend-only oEmbed credential, if required by the Meta app/provider.
META_OEMBED_ACCESS_TOKEN=
# YouTube is optional; Instagram is the first launch network.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
